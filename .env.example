# ==========================================
# NewsPulse - Environment Configuration
# ==========================================

# Google Gemini API Key (Optional but recommended)
# Get your free key at: https://aistudio.google.com/
# If left blank, NewsPulse automatically uses its smart rule-based NLP engine.
GEMINI_API_KEY=

# AI Model Selection (Official latest model: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Site Branding & Identity
SITE_NAME=NewsPulse
SITE_TAGLINE=Bite-Sized Breaking News & Visual Stories
SITE_DESCRIPTION=Real-time, factual 60-word news summaries and immersive visual AMP Web Stories powered by AI.
SITE_URL=https://newspulse-portal.vercel.app

# Publisher & Contact Details (Used in Schema & Compliance Pages)
PUBLISHER_NAME=NewsPulse Media Network
EDITORIAL_EMAIL=editorial@newspulse.media
DMCA_EMAIL=dmca@newspulse.media
CONTACT_ADDRESS=548 Market St, Suite 72401, San Francisco, CA 94104

# Ingestion Settings
MAX_ARTICLES_PER_CATEGORY=3
