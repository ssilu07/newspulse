{
  "version": 2,
  "outputDirectory": "dist",
  "cleanUrls": true,
  "routes": [
    {
      "src": "/static/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/static/$1"
    },
    {
      "src": "^/+sitemap_index\\.xml$",
      "headers": {
        "content-type": "application/xml; charset=utf-8"
      },
      "dest": "/sitemap_index.xml"
    },
    {
      "src": "^/+sitemap-main\\.xml$",
      "headers": {
        "content-type": "application/xml; charset=utf-8"
      },
      "dest": "/sitemap-main.xml"
    },
    {
      "src": "^/+sitemap\\.xml$",
      "headers": {
        "content-type": "application/xml; charset=utf-8"
      },
      "dest": "/sitemap.xml"
    },
    {
      "src": "^/+news-sitemap\\.xml$",
      "headers": {
        "content-type": "application/xml; charset=utf-8"
      },
      "dest": "/news-sitemap.xml"
    },
    {
      "src": "^/+(feed|rss)\\.xml$",
      "headers": {
        "content-type": "application/rss+xml; charset=utf-8"
      },
      "dest": "/feed.xml"
    },
    {
      "src": "/favicon.ico",
      "headers": {
        "content-type": "image/x-icon",
        "cache-control": "public, max-age=86400"
      },
      "dest": "/favicon.ico"
    },
    {
      "src": "/robots.txt",
      "headers": {
        "content-type": "text/plain; charset=utf-8"
      },
      "dest": "/robots.txt"
    },
    {
      "src": "/manifest.json",
      "headers": {
        "content-type": "application/json; charset=utf-8"
      },
      "dest": "/manifest.json"
    },
    {
      "src": "/ads.txt",
      "headers": {
        "content-type": "text/plain; charset=utf-8"
      },
      "dest": "/ads.txt"
    },
    {
      "src": "/(79624caa6fca40dfbc227ab2ed0f7f42|b4f910a2d3e54c7b89f0123456789abc)\\.txt",
      "headers": {
        "content-type": "text/plain; charset=utf-8"
      },
      "dest": "/$1.txt"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/news/.*$",
      "status": 301,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "^/stories/.*$",
      "status": 301,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
