{
  "version": 2,
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/static/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/static/$1"
    },
    {
      "src": "^/+sitemap_index\\.xml$",
      "headers": {
        "content-type": "application/xml; charset=utf-8"
      },
      "dest": "/sitemap_index.xml"
    },
    {
      "src": "^/+sitemap-main\\.xml$",
      "headers": {
        "content-type": "application/xml; charset=utf-8"
      },
      "dest": "/sitemap-main.xml"
    },
    {
      "src": "^/+sitemap\\.xml$",
      "headers": {
        "content-type": "application/xml; charset=utf-8"
      },
      "dest": "/sitemap.xml"
    },
    {
      "src": "^/+news-sitemap\\.xml$",
      "headers": {
        "content-type": "application/xml; charset=utf-8"
      },
      "dest": "/news-sitemap.xml"
    },
    {
      "src": "/favicon.ico",
      "headers": {
        "content-type": "image/x-icon",
        "cache-control": "public, max-age=86400"
      },
      "dest": "/favicon.ico"
    },
    {
      "src": "/robots.txt",
      "headers": {
        "content-type": "text/plain; charset=utf-8"
      },
      "dest": "/robots.txt"
    },
    {
      "src": "/manifest.json",
      "headers": {
        "content-type": "application/json; charset=utf-8"
      },
      "dest": "/manifest.json"
    },
    {
      "src": "/stories/(.*)",
      "dest": "/stories/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
