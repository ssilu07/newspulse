{
  "version": 2,
  "buildCommand": "python fetch_and_generate.py --count 3 --skip-val",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/static/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/static/$1"
    },
    {
      "src": "/sitemap.xml",
      "headers": {
        "content-type": "application/xml; charset=utf-8"
      },
      "dest": "/sitemap.xml"
    },
    {
      "src": "/robots.txt",
      "headers": {
        "content-type": "text/plain; charset=utf-8"
      },
      "dest": "/robots.txt"
    },
    {
      "src": "/manifest.json",
      "headers": {
        "content-type": "application/json; charset=utf-8"
      },
      "dest": "/manifest.json"
    },
    {
      "src": "/stories/(.*)",
      "dest": "/stories/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
