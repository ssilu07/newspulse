# ==========================================
# NewsPulse - Environment Configuration
# ==========================================

# Google Gemini API Key (Optional but recommended)
# Get your free key at: https://aistudio.google.com/
# If left blank, NewsPulse automatically uses its smart rule-based NLP engine.
GEMINI_API_KEY=

# AI Model Selection (Official latest model: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Site Branding & Identity
SITE_NAME=NewsPulse
SITE_TAGLINE=Bite-Sized Breaking News & Visual Stories
SITE_DESCRIPTION=Real-time, factual 60-word news summaries and immersive visual AMP Web Stories powered by AI.
SITE_URL=https://newspulse-daily.vercel.app

# Publisher & Contact Details (Used in Schema & Compliance Pages)
PUBLISHER_NAME=NewsPulse Media Network
EDITORIAL_EMAIL=editorial@newspulse.media
DMCA_EMAIL=dmca@newspulse.media
CONTACT_ADDRESS=548 Market St, Suite 72401, San Francisco, CA 94104

# Ingestion Settings
MAX_ARTICLES_PER_CATEGORY=3

# ==========================================
# Automated Social Media Syndication (100% Free APIs)
# ==========================================

# X (Twitter) API v2 (Free tier - 500 tweets/month)
# Get from: https://developer.x.com/
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Reddit API (Free personal script app)
# Get from: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
# Subreddit to post to (default: u_<your_username> or e.g. technology)
REDDIT_SUBREDDIT=

# Telegram Channel / Group (100% Free - Unlimited instant broadcasts)
# 1. Create bot via @BotFather on Telegram -> get token
# 2. Add bot as admin to your channel -> get chat_id (e.g. @your_channel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LinkedIn Community Management API (100% Free)
# Get token from: https://www.linkedin.com/developers/
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
